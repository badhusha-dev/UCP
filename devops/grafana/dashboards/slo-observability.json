{
  "id": null,
  "uid": "ecommerce-slo-observability",
  "title": "Universal Commerce — SLO Observability & Alerting",
  "tags": ["ecommerce", "slo", "alerting", "promql", "resilience"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, service)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "label": "Service Scope",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Global Service Availability SLO (Target: 99.9%)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "avg(up{service=~\"api-gateway|user-service|product-service|order-service|notification-service\"}) * 100",
        "legendFormat": "Availability %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 98.0 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P99 Gateway Latency SLO (Target: < 500ms)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=\"api-gateway\"}[5m])) by (le)) * 1000",
        "legendFormat": "P99 Latency (ms)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Critical & Warning Alerts",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
        "legendFormat": "Firing Alerts"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLO Error Budget Remaining (30d)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "clamp_min(100 - ((sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1h])) or vector(0)) / (sum(rate(http_server_requests_seconds_count[1h])) or vector(1))) * 100000, 0)",
        "legendFormat": "Budget Remaining %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "P99 API Latency vs 500ms SLO Threshold",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=~\"$service\"}[3m])) by (le, service))",
          "legendFormat": "{{service}} - P99"
        },
        {
          "expr": "0.500",
          "legendFormat": "SLO Threshold (500ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 5xx Error Rate (%) vs 2.0% SLO Alert Limit",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\",service=~\"$service\"}[2m])) by (service) / sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[2m])) by (service)) * 100",
          "legendFormat": "{{service}} 5xx Rate %"
        },
        {
          "expr": "2.0",
          "legendFormat": "SLO Limit (2.0%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Resilience4j Circuit Breaker State (0=Closed, 1=Half-Open, 2=Open)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{state=\"closed\"} * 0 + resilience4j_circuitbreaker_state{state=\"half_open\"} * 1 + resilience4j_circuitbreaker_state{state=\"open\"} * 2",
          "legendFormat": "{{name}} ({{service}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "HALF-OPEN", "color": "orange" }, "2": { "text": "OPEN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HikariCP Database Pool Saturation (%)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(hikaricp_connections_active{service=~\"$service\"} / hikaricp_connections_max{service=~\"$service\"}) * 100",
          "legendFormat": "{{service}} - {{pool}}"
        },
        {
          "expr": "90.0",
          "legendFormat": "Alert Threshold (90%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    }
  ]
}

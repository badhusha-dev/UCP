{
  "id": null,
  "uid": "jvm-micrometer",
  "title": "JVM (Micrometer)",
  "tags": ["jvm", "spring-boot", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(jvm_memory_used_bytes, service)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "label": "Service",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Heap Used",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\", service=\"$service\"})", "legendFormat": "Heap Used" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{"color":"green","value":0},{"color":"orange","value":400000000},{"color":"red","value":700000000}] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Heap Max",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(jvm_memory_max_bytes{area=\"heap\", service=\"$service\"})", "legendFormat": "Heap Max" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live Threads",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "jvm_threads_live_threads{service=\"$service\"}", "legendFormat": "Threads" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Classes Loaded",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "jvm_classes_loaded_classes{service=\"$service\"}", "legendFormat": "Classes" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "process_cpu_usage{service=\"$service\"}", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "process_uptime_seconds{service=\"$service\"}", "legendFormat": "Uptime" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM Memory — Heap & Non-Heap",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\", service=\"$service\"}) by (id)", "legendFormat": "heap: {{id}}" },
        { "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\", service=\"$service\"}) by (id)", "legendFormat": "non-heap: {{id}}" },
        { "expr": "sum(jvm_memory_committed_bytes{area=\"heap\", service=\"$service\"})", "legendFormat": "heap committed" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Garbage Collection — Pause Time Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{service=\"$service\"}[1m])", "legendFormat": "{{action}} {{cause}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC Collections Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_count{service=\"$service\"}[1m])", "legendFormat": "{{action}} {{cause}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JVM Threads State",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "jvm_threads_states_threads{service=\"$service\"}", "legendFormat": "{{state}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HikariCP DB Connection Pool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "hikaricp_connections_active{service=\"$service\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{service=\"$service\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{service=\"$service\"}", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max{service=\"$service\"}", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    }
  ]
}

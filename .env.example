# ==============================================================================
# UNIVERSAL COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' before running any deployment script:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL!
# Generate cryptographic secrets using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM & ENVIRONMENT METADATA
# ------------------------------------------------------------------------------
# Purpose: Environment tier (development, staging, production)
# Required: YES | Default: production | Sensitive: NO | Services: All | Restart: YES
ENVIRONMENT=production

# Purpose: Fully Qualified Domain Name or host IP for the platform
# Required: YES | Default: localhost | Sensitive: NO | Services: API Gateway, MFEs | Restart: YES
PLATFORM_HOST=localhost

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Purpose: PostgreSQL master superuser username
# Required: YES | Default: postgres | Sensitive: NO | Services: Postgres, Microservices | Restart: YES
POSTGRES_USER=postgres

# Purpose: PostgreSQL master superuser password
# Required: YES | Default: postgres_secure_pass_change_me | Sensitive: YES | Services: Postgres, Microservices | Restart: YES
POSTGRES_PASSWORD=ReplaceWithStrongPassword123!

# Purpose: External port mapped for PostgreSQL
# Required: NO | Default: 5432 | Sensitive: NO | Services: Host mapping | Restart: YES
POSTGRES_PORT=5432

# Purpose: Database names for domain microservices
# Required: YES | Default: user_db, product_db, order_db, notification_db | Sensitive: NO
USER_DB_NAME=user_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
NOTIFICATION_DB_NAME=notification_db

# ------------------------------------------------------------------------------
# 3. CACHE & IN-MEMORY STORE (Redis)
# ------------------------------------------------------------------------------
# Purpose: Redis authentication password (empty for local dev, mandatory for prod)
# Required: NO | Default: redis_auth_secret_change_me | Sensitive: YES | Services: Redis, Product Service | Restart: YES
REDIS_PASSWORD=ReplaceWithStrongRedisPassword456!

# Purpose: Redis port mapped to host
# Required: NO | Default: 6379 | Sensitive: NO | Services: Redis | Restart: YES
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. MESSAGE BROKER (Apache Kafka & ZooKeeper)
# ------------------------------------------------------------------------------
# Purpose: Kafka broker external mapped port
# Required: NO | Default: 9092 | Sensitive: NO | Services: Kafka, Microservices | Restart: YES
KAFKA_PORT=9092

# Purpose: Kafka UI web administration port
# Required: NO | Default: 8090 | Sensitive: NO | Services: Kafka UI | Restart: YES
KAFKA_UI_PORT=8090

# ------------------------------------------------------------------------------
# 5. SECURITY & JWT (JSON Web Tokens)
# ------------------------------------------------------------------------------
# Purpose: HMAC-SHA256 Secret Key for signing and validating JWTs (Min 256-bit / 32 chars)
# Required: YES | Default: [Generate via openssl rand -base64 48] | Sensitive: YES | Services: User Service, API Gateway | Restart: YES
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Secret (32+ chars) for hashing delivery handover codes; Delivery refuses proof verification without it.
DELIVERY_OTP_PEPPER=CHANGE_ME_generate_with_openssl_rand_hex_32
# Shared secret for service-to-service callbacks (X-Service-Token). Required: docker compose refuses to start without it,
# so the well-known code default (local-dev-service-token-change-me) can no longer be used by a running stack.
SERVICE_TO_SERVICE_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# Purpose: Token validity lifetime in milliseconds (86400000 = 24 hours)
# Required: NO | Default: 86400000 | Sensitive: NO | Services: User Service | Restart: YES
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & MONITORING (Prometheus, Grafana, Zipkin, ELK)
# ------------------------------------------------------------------------------
# Purpose: Grafana Administrator username
# Required: YES | Default: admin | Sensitive: NO | Services: Grafana | Restart: YES
GRAFANA_ADMIN_USER=admin

# Purpose: Grafana Administrator password
# Required: YES | Default: grafana_admin_pass_change_me | Sensitive: YES | Services: Grafana | Restart: YES
GRAFANA_ADMIN_PASSWORD=ReplaceWithStrongGrafanaAdminPassword789!

# Purpose: Port mapping for Observability tools
# Required: NO | Sensitive: NO | Restart: YES
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
ALERTMANAGER_PORT=9093
ZIPKIN_PORT=9411
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# ------------------------------------------------------------------------------
# 7. JVM RUNTIME MEMORY LIMITS
# ------------------------------------------------------------------------------
# Purpose: Maximum heap size per microservice container
# Required: NO | Default: -Xms256m -Xmx512m | Sensitive: NO | Services: Java containers | Restart: YES
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# Purpose: Elasticsearch JVM heap allocation
# Required: NO | Default: 1g | Sensitive: NO | Services: Elasticsearch | Restart: YES
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ------------------------------------------------------------------------------
# 8. INITIAL SUPER ADMIN BOOTSTRAP (OPTIONAL)
# ------------------------------------------------------------------------------
# Set these in your private .env file, never commit real credentials.
# An existing active ADMIN account can be promoted with SUPER_ADMIN_EMAIL alone.
# To create the first account or reset the disabled legacy seed, provide a
# password of at least 12 characters. These values are read at user-service startup.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Super Admin
